# Generated by cargo-eb {{ prog_version }}. Re-run `cargo eb --update`
# to refresh CRATES/GIT_CRATES/LICENSE/IUSE rather than hand-editing them.

EAPI=8

inherit cargo

DESCRIPTION="{{ description }}"
{% if homepage %}
HOMEPAGE="{{ homepage }}"
{% endif %}

{% if crate_tarball %}
# Crate tarball
SRC_URI+=" {{ crate_tarball }}"
{% else %}
CRATES="{{ crates }}"{{ git_crates }}
SRC_URI="${CARGO_CRATE_URIS}"
{% endif %}

LICENSE="{{ pkg_license }}"
{% if crate_licenses %}
# Dependent crate licenses
LICENSE+="{{ crate_licenses }}"
{% endif %}

SLOT="0"
KEYWORDS="~amd64"
{% if iuse_plus %}
# Cargo features
IUSE+="{{ iuse_plus }}"

src_configure() {
	local myfeatures=(
{{ myfeatures }}
	)
	cargo_src_configure
}
{% endif %}
