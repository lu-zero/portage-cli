# Generated by cargo-eb {{ prog_version }}. Re-run `cargo eb --update`
# to refresh CRATES/GIT_CRATES/SRC_URI/LICENSE/IUSE rather than hand-editing them.

EAPI=8

{% if not crate_tarball %}
CRATES="{{ crates }}"{{ git_crates }}

{% endif %}
inherit cargo

DESCRIPTION="{{ description }}"
{% if homepage %}
HOMEPAGE="{{ homepage }}"
{% endif %}

{% if source_tarball %}
# Source snapshot
SRC_URI="{{ source_tarball }}"
{% endif %}
{% if crate_tarball %}
# Crate tarball
SRC_URI+=" {{ crate_tarball }}"
{% else %}
SRC_URI+=" ${CARGO_CRATE_URIS}"
{% endif %}
{% if s_dir %}
# Workspace member
S="${WORKDIR}/${P}/{{ s_dir }}"
{% endif %}

LICENSE="{{ pkg_license }}"
{% if crate_licenses %}
# Dependent crate licenses
LICENSE+="{{ crate_licenses }}"
{% endif %}

SLOT="0"
KEYWORDS="~amd64"
{% if iuse_plus %}
# Cargo features
IUSE+="{{ iuse_plus }}"
{% endif %}
{% if extra_sources %}

src_unpack() {
	cargo_src_unpack
	# Vendored git sources
	cat "${ECARGO_HOME}/sources.toml" >> "${ECARGO_HOME}/config.toml" || die
}
{% endif %}
{% if iuse_plus or configure_args %}

src_configure() {
{% if iuse_plus %}
	local myfeatures=(
{{ myfeatures }}
	)
{% endif %}
	cargo_src_configure{{ configure_args }}
}
{% endif %}
