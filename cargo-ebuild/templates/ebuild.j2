# Generated by cargo-ebuild {{ prog_version }}. Re-run the generator to
# update CRATES/GIT_CRATES/LICENSE rather than hand-editing them.

EAPI=8

inherit cargo

DESCRIPTION="{{ description }}"
HOMEPAGE="{{ homepage }}"

CRATES="{{ crates }}"{{ git_crates }}
SRC_URI="${CARGO_CRATE_URIS}"
{% if crate_tarball is defined and crate_tarball %}
if [[ ${PKGBUMPING} != ${PVR} ]]; then
	SRC_URI+=" {{ crate_tarball }}"
fi
{% endif %}

LICENSE="{{ pkg_license }}"
{% if crate_licenses is defined and crate_licenses %}
# Dependent crate licenses
LICENSE+="{{ crate_licenses }}"
{% endif %}

SLOT="0"
KEYWORDS="~amd64"
{% if pkg_features is defined and pkg_features %}
IUSE="{{ pkg_features }}"

src_configure() {
	local myfeatures=(
{{ pkg_features_use }}
	)
	cargo_src_configure
}
{% endif %}
